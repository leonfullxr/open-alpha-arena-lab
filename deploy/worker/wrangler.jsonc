{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-alpha-arena-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/simulation", "/simulation/*", "/admin", "/admin/*", "/admin-assets", "/admin-assets/*"]
  },
  "vars": {
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": "",
    "ADMIN_SUBJECTS": ""
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "landing": {
      "name": "open-alpha-arena-landing",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../../dist/web",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/api/*", "/simulation", "/simulation/*", "/admin", "/admin/*", "/admin-assets", "/admin-assets/*"]
      },
      "vars": {
        "ACCESS_ISSUER": "",
        "ACCESS_AUDIENCE": "",
        "ADMIN_SUBJECTS": ""
      }
    }
  }
}
