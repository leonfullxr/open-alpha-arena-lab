# Local demo only. Copy to .env for Compose. Never reuse these disposable
# development database credentials elsewhere.
APP_MODE=demo
AUTH_MODE=local
ARENA_ENV_FILE=.env
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://arena:arena-dev-only-change-me@db:5432/arena
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena-dev-only-change-me
MARKET_PROVIDER=demo
EXECUTION_MODE=paper
ENABLE_REAL_TRADING=false
ENABLE_INFERENCE=false
ENABLE_MOCK_INFERENCE=false
MAX_DAILY_LLM_SPEND_USD=5
DB_PORT=15432
API_PORT=8000
WEB_PORT=3000
OPENAI_API_KEY=
OPENCODE_API_KEY=
