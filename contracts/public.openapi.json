  "info": {
    "title": "Open Alpha Arena Lab Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/competitions": {
      "get": {
        "operationId": "competitions_competitions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CompetitionSummary"
                  },
                  "title": "Response Competitions Competitions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Competitions"
      }
    },
    "/competitions/{competition_id}": {
      "get": {
        "operationId": "competition_competitions__competition_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "competition_id",
            "required": true,
            "schema": {
              "title": "Competition Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Competition"
      }
    },
    "/competitions/{competition_id}/decisions": {
      "get": {
        "operationId": "decisions_competitions__competition_id__decisions_get",
        "parameters": [
          {
            "in": "path",
            "name": "competition_id",
            "required": true,
            "schema": {
              "title": "Competition Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageDTO_DecisionDTO_"
                }
              }
            },
            "description": "Successful Response"
